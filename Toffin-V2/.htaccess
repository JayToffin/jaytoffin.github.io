# ════════════════════════════════════════════════════════════════════
# Toffin Indonesia — .htaccess
# Apache config untuk shared hosting / cPanel
# ════════════════════════════════════════════════════════════════════

# ── 1. CHARSET ──────────────────────────────────────────────────────
AddDefaultCharset UTF-8

# ── 2. CUSTOM ERROR PAGES ───────────────────────────────────────────
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
ErrorDocument 500 /404.html

# ── 3. DISABLE DIRECTORY LISTING ────────────────────────────────────
# Cegah pengunjung lihat isi folder /assets/, /assets/img/, dll.
Options -Indexes

# ── 4. PROTECT SENSITIVE FILES ──────────────────────────────────────
<FilesMatch "^\.(htaccess|htpasswd|env|gitignore)$">
  Require all denied
</FilesMatch>

# Protect email templates directory (internal reference, jangan ter-index)
<FilesMatch "(?i)\.(md|log|sql|bak|backup|swp|sh)$">
  Require all denied
</FilesMatch>

# ── 5. URL REWRITES (HTTPS + www + hide .html) ──────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 5a. Redirect HTTP → HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 5b. Force www (canonical: https://www.toffin.id)
  # Comment line di bawah kalau prefer non-www (https://toffin.id)
  RewriteCond %{HTTP_HOST} ^toffin\.id$ [NC]
  RewriteRule ^(.*)$ https://www.toffin.id/$1 [L,R=301]

  # 5c. Redirect /page.html → /page (canonical clean URL, SEO)
  RewriteCond %{THE_REQUEST} ^[A-Z]+\s/([^\s]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # 5d. Internally rewrite /page → /page.html (serve content tanpa expose ekstensi)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^\.]+)$ $1.html [L]
</IfModule>

# ── 6. GZIP COMPRESSION ─────────────────────────────────────────────
# Compress HTML, CSS, JS, SVG sebelum dikirim ke browser (~70% lebih kecil)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE font/otf
  AddOutputFilterByType DEFLATE application/font-woff
  AddOutputFilterByType DEFLATE application/font-woff2
</IfModule>

# ── 7. BROWSER CACHING ──────────────────────────────────────────────
# Set cache duration untuk static assets — repeat visitors load lebih cepat
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — cache singkat (1 jam) supaya update content cepat propagate
  ExpiresByType text/html "access plus 1 hour"

  # CSS / JS — cache 1 minggu (update via cache-busting query string saat deploy)
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"

  # Images — cache 1 bulan
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fonts — cache 1 tahun (jarang berubah)
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # XML feeds — cache 1 jam
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"

  # Default fallback
  ExpiresDefault "access plus 1 week"
</IfModule>

# ── 8. SECURITY HEADERS ─────────────────────────────────────────────
<IfModule mod_headers.c>
  # Cegah clickjacking — block site di-embed dalam iframe
  Header always set X-Frame-Options "SAMEORIGIN"

  # MIME type sniffing prevention
  Header always set X-Content-Type-Options "nosniff"

  # Referrer policy — kirim referrer hanya ke same-origin atau lebih aman
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions Policy — disable fitur browser yang tidak dipakai
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # HSTS — force HTTPS selama 1 tahun (uncomment SETELAH yakin HTTPS jalan stabil)
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # CORS untuk fonts (jika serve font sendiri)
  <FilesMatch "\.(ttf|otf|woff|woff2)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  # Remove Server signature
  Header unset X-Powered-By
  Header always unset X-Powered-By
</IfModule>

ServerSignature Off

# ── 9. MIME TYPES (kalau hosting tidak auto-detect) ─────────────────
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType application/font-woff2 .woff2
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
  AddType text/cache-manifest .appcache
</IfModule>

# ── 10. PREVENT HOTLINKING (optional) ───────────────────────────────
# Cegah situs lain pakai bandwidth Toffin dengan embed langsung gambar.
# Uncomment block di bawah kalau mau aktif.
#
# <IfModule mod_rewrite.c>
#   RewriteCond %{HTTP_REFERER} !^$
#   RewriteCond %{HTTP_REFERER} !^https?://(www\.)?toffin\.id [NC]
#   RewriteCond %{HTTP_REFERER} !^https?://(www\.)?google\.[a-z]+ [NC]
#   RewriteRule \.(jpg|jpeg|png|webp|gif)$ - [F,L]
# </IfModule>
